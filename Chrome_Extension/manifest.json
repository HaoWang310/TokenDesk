{
  "manifest_version": 3,
  "name": "TokenDesk 网页额度同步",
  "version": "1.8.10",
  "description": "Chrome 后台同步 ChatGPT 剩余额度，并监控已打开 ChatGPT 标签页中的思考 / 工作任务。",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:18743/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "extract.js",
        "task-monitor.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "network-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TokenDesk 网页用量同步",
    "default_popup": "popup.html"
  }
}
