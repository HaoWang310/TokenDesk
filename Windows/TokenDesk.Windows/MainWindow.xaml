<Window x:Class="TokenDesk.WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenDesk" Width="430" Height="760"
        MinWidth="390" MinHeight="620"
        Background="#111318" Foreground="#F4F4F5"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Background" Value="#252933"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Background" Value="#181B22"/>
            <Setter Property="BorderBrush" Value="#343946"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="TokenDesk" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Windows · ChatGPT 用量与任务监控" Foreground="#8E96A8" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#1D222B" CornerRadius="12" Padding="10,6" HorizontalAlignment="Right">
                    <TextBlock x:Name="ConnectionText" Text="等待 Chrome…" Foreground="#9DA8BA" FontSize="10"/>
                </Border>
            </DockPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1A1E25" CornerRadius="15" Padding="14">
                    <StackPanel>
                        <TextBlock Text="5 小时剩余" Foreground="#8E96A8" FontSize="11"/>
                        <TextBlock x:Name="FiveHourText" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="FiveHourResetText" Text="重置：—" Foreground="#70798A" FontSize="9.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#1A1E25" CornerRadius="15" Padding="14">
                    <StackPanel>
                        <TextBlock Text="每周剩余" Foreground="#8E96A8" FontSize="11"/>
                        <TextBlock x:Name="WeeklyText" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="WeeklyResetText" Text="重置：—" Foreground="#70798A" FontSize="9.5" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#1A1E25" CornerRadius="15" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="历史额度" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HistoryRangeText" DockPanel.Dock="Right" Text="—" Foreground="#7F8898" FontSize="9.5"/>
                    </DockPanel>
                    <Canvas x:Name="HistoryCanvas" Height="145" Margin="0,10,0,0" SizeChanged="HistoryCanvas_SizeChanged"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="5h" Foreground="#7ECFB0" FontSize="9"/>
                        <TextBlock Text="周" Foreground="#91A8FF" FontSize="9" Margin="12,0,0,0"/>
                        <TextBlock x:Name="ResetCountText" DockPanel.Dock="Right" Text="可用重置：—" Foreground="#7F8898" FontSize="9"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Background="#1A1E25" CornerRadius="15" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="本周使用统计（周一至周日）" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="每周一 00:00 清零" DockPanel.Dock="Right" Foreground="#7F8898" FontSize="9.5"/>
                    </DockPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#151920" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="今天总使用时长" Foreground="#7F8898" FontSize="9.5"/>
                                <TextBlock x:Name="TodayActiveText" Text="0秒" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#151920" CornerRadius="10" Padding="10">
                            <StackPanel>
                                <TextBlock Text="本周总使用时长" Foreground="#7F8898" FontSize="9.5"/>
                                <TextBlock x:Name="WeekActiveText" Text="0秒" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="统计 ChatGPT 网页活跃使用时间 + 已确认的后台 Thinking / Working 运行时间；重叠只计一次。无任务的闲置页面不计时，已关闭网页的待确认任务不计时。"
                               Foreground="#7F8898" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="每日使用时间" Foreground="#AAB2C0" FontSize="10" FontWeight="SemiBold"/>
                    <Canvas x:Name="ActiveUsageCanvas" Height="116" Margin="0,6,0,10" SizeChanged="WeeklyCanvas_SizeChanged"/>

                    <TextBlock Text="每日用量（每周额度下降百分点）" Foreground="#AAB2C0" FontSize="10" FontWeight="SemiBold"/>
                    <Canvas x:Name="QuotaUsageCanvas" Height="116" Margin="0,6,0,8" SizeChanged="WeeklyCanvas_SizeChanged"/>

                    <TextBlock x:Name="WeekQuotaTotalText"
                               Text="本周用量累计：0 个百分点。每周一自动清零；安装前数据不能补录，统计不影响 ChatGPT 官方额度。"
                               TextWrapping="Wrap" Foreground="#70798A" FontSize="9.2"/>
                </StackPanel>
            </Border>

            <Border Background="#1A1E25" CornerRadius="15" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="运行任务" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TaskSummaryText" DockPanel.Dock="Right" Text="任务 0" Foreground="#7ECFB0" FontSize="10" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock x:Name="NoTasksText" Text="当前没有检测到正在运行的 ChatGPT 网页任务"
                               Foreground="#747D8D" FontSize="10" Margin="0,6,0,4"/>
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding PageUrl}" Click="TaskOpen_Click" Padding="10" Margin="0,3,0,3" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ModelLabel}" Foreground="#91A8FF" FontSize="9" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Elapsed}" Foreground="#747D8D" FontSize="9" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#303642" CornerRadius="9" Padding="7,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PhaseLabel}" FontSize="9" Foreground="{Binding PhaseBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="#1A1E25" CornerRadius="15" Padding="14">
                <StackPanel>
                    <TextBlock Text="浏览器连接" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="配对码" Foreground="#8E96A8" FontSize="10"/>
                    <Grid Margin="0,5,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PairingCodeText" IsReadOnly="True" FontFamily="Consolas" FontSize="9.5"/>
                        <Button Grid.Column="2" Content="复制" Click="CopyPairing_Click"/>
                    </Grid>
                    <WrapPanel>
                        <Button Content="打开扩展文件夹" Click="OpenExtensionFolder_Click" Margin="0,0,8,8"/>
                        <Button Content="Chrome 扩展页" Click="OpenChromeExtensions_Click" Margin="0,0,8,8"/>
                        <Button Content="Edge 扩展页" Click="OpenEdgeExtensions_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <CheckBox x:Name="AutoStartCheck" Content="登录 Windows 后自动启动到托盘"
                              Foreground="#CDD2DC" Margin="0,4,0,0"
                              Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                    <TextBlock Text="提醒：5小时/每周的20%与刷新通知均按周期只发一次。额度读取不要求打开 ChatGPT 页面；模型识别和使用时长记录需要 Chrome/Edge 中的 ChatGPT 网页在前台，安装前的数据无法回溯。"
                               TextWrapping="Wrap" Foreground="#70798A" FontSize="9.5" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="TokenDesk Windows v1.2.11 · 本机仅监听 127.0.0.1:18743"
                       HorizontalAlignment="Center" Foreground="#555E6E" FontSize="9" Margin="0,14,0,2"/>
        </StackPanel>
    </ScrollViewer>
</Window>
